#!/bin/bash
# ==============================================================================
# ⏰ SO-101 Automated Timed Training: Trains Arm + Vision Until 9:00 PM
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="/Users/nam/miniforge3/envs/lerobot/bin/python"
LOG_DIR="$SCRIPT_DIR/outputs/logs"
mkdir -p "$LOG_DIR"

TARGET_TIME_STR="${1:-21:00}" # Default: 9:00 PM

NOW_EPOCH=$(date +%s)
TARGET_EPOCH=$(date -j -f "%Y-%m-%d %H:%M" "$(date +%Y-%m-%d) $TARGET_TIME_STR" +%s 2>/dev/null)

if [ -z "$TARGET_EPOCH" ] || [ "$TARGET_EPOCH" -le "$NOW_EPOCH" ]; then
    TARGET_EPOCH=$(date -j -f "%Y-%m-%d %H:%M" "$(date +%Y-%m-%d) 21:00" +%s)
fi

DURATION_SEC=$((TARGET_EPOCH - NOW_EPOCH))
HOURS=$((DURATION_SEC / 3600))
MINS=$(((DURATION_SEC % 3600) / 60))

echo "========================================================================"
echo "⏰ AUTOMATED TIMED TRAINING SCHEDULED"
echo "   • Start Time       : $(date +'%I:%M %p')"
echo "   • Stop Time        : 09:00 PM sharp ($TARGET_TIME_STR)"
echo "   • Total Run Time   : $HOURS hours, $MINS minutes ($DURATION_SEC seconds)"
echo "   • Training Models  : 🦾 Arm Pick-and-Lift (RL) + 🧠 Vision AI (CNN)"
echo "========================================================================"

# Step 1: Kill any stale runs to start 100% clean
pkill -f "train_rl_ppo.py" 2>/dev/null
pkill -f "train_vision_ai.py" 2>/dev/null
sleep 1

# Step 2: Launch Arm RL Training in Background with Caffeinate
RL_STEPS=50000000
caffeinate -dis "$PYTHON_BIN" "$SCRIPT_DIR/train_rl_ppo.py" --num_envs 8 --timesteps $RL_STEPS > "$LOG_DIR/train_rl.log" 2>&1 &
RL_PID=$!

# Step 3: Launch Vision AI Training in Background with Caffeinate
VISION_STEPS=60000
caffeinate -dis "$PYTHON_BIN" "$SCRIPT_DIR/train_vision_ai.py" --steps $VISION_STEPS > "$LOG_DIR/train_vision.log" 2>&1 &
VISION_PID=$!

# Step 4: Open Live Log Windows for User via AppleScript
osascript -e "tell application \"Terminal\" to do script \"tail -f '$LOG_DIR/train_rl.log'\"" > /dev/null 2>&1
sleep 1
osascript -e "tell application \"Terminal\" to do script \"tail -f '$LOG_DIR/train_vision.log'\"" > /dev/null 2>&1

echo -e "\n✅ \033[1;32mTRAINING IS ACTIVELY RUNNING!\033[0m"
echo "   • 🦾 Arm RL Training PID    : $RL_PID (Log: outputs/logs/train_rl.log)"
echo "   • 🧠 Vision AI Training PID  : $VISION_PID (Log: outputs/logs/train_vision.log)"
echo "   • ⏳ Auto-Timer active: Will stop automatically at 9:00 PM sharp."
echo "========================================================================"

# Background watchdog to stop at 9:00 PM
(
    sleep "$DURATION_SEC"
    echo -e "\n⏰ [9:00 PM REACHED] Finalizing and saving all model checkpoints..."
    kill -TERM "$RL_PID" "$VISION_PID" 2>/dev/null
    pkill -f "train_rl_ppo.py" 2>/dev/null
    pkill -f "train_vision_ai.py" 2>/dev/null
    afplay /System/Library/Sounds/Glass.aiff 2>/dev/null || true
    echo "✅ Training session successfully completed and saved at 9:00 PM!"
) &

